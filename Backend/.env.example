PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/scrapconnect

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (image storage — required in production, local disk is used as fallback in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
